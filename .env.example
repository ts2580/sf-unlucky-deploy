# ./start-local.sh가 읽는 설정. 아래에 없는 항목은 기본값을 사용합니다.
# true: 로그인 없이 실행 OS 계정의 sf CLI 인증 사용. 주소는 127.0.0.1로 고정.
# false: 로그인 필수, Salesforce와 Git 연결을 사용자별로 관리.
LOCAL=false

# LOCAL=false에서 사용자별 연결을 저장할 때 필요한 암호화 키.
# 각 값은 별도로 `openssl rand -hex 32`로 만들고 기존 DB를 쓰는 동안 유지하세요.
# SFUD_TOKEN_SECRET=

# LOCAL=false에서 서버가 Salesforce 브라우저 OAuth를 제공할 때 사용합니다.
# OAuth 앱 Web Server Flow + refresh_token/API scope, HTTPS callback 등록이 필요합니다.
# Callback: SFUD_PUBLIC_ORIGIN + /api/v1/salesforce/oauth/callback
# SFUD_SF_OAUTH_CLIENT_ID=
# SFUD_SF_OAUTH_CLIENT_SECRET=

# 필요할 때만 설정하세요. 기본 UI 주소는 127.0.0.1:27546입니다.
# SFUD_DATA_DIR=/path/to/sfud-data
# SFUD_UI_PORT=27546

# 원격 HTTPS 프록시로 공개할 때만 함께 설정하세요. LOCAL=true에서는 무시합니다.
# SFUD_UI_HOST=0.0.0.0
# SFUD_PUBLIC_ORIGIN=https://deploy.example.com
# SFUD_TRUSTED_PROXIES=127.0.0.1
