# start-local.sh local runtime configuration
SFUD_UI_HOST=127.0.0.1
SFUD_UI_PORT=27546

# Configure both values when the UI is exposed through an HTTPS reverse proxy.
# SFUD_PUBLIC_ORIGIN=https://deploy.example.com
# SFUD_TRUSTED_PROXIES=127.0.0.1

# Git PAT/API Token 저장: 32~1024자 암호화 문자열. openssl rand -hex 32 결과 권장.
# 앞뒤 공백/줄바꿈 불가. 같은 DB에서는 값을 계속 유지하고 .env를 안전하게 백업.
# SFUD_GIT_TOKEN_SECRET=
# SFUD_GIT_TOKEN_KEY_VERSION=1

# 기존 키 파일 방식도 지원. SECRET이 설정되어 있으면 문자열 방식 우선 (빈 값도 오류).
# 문자열 방식 사용 시 아래 KEY_FILE은 설정하지 않음. 기존 암호문은 자동 변환되지 않음.
# 32-byte 바이너리 파일, POSIX 0600.
# SFUD_GIT_TOKEN_KEY_FILE=/secure/sfud-git-token-key

# UI에서 직접 등록하거나 아래 환경변수를 지정한 뒤 설정의 '환경변수 토큰 등록' 사용.
# 소유 SFUD 사용자 이메일이 일치해야 등록 가능하며, 기존 UI 토큰을 자동 덮어쓰지 않음.
# SFUD_GIT_TOKEN_OWNER_EMAIL=operator@example.com
# SFUD_GITHUB_TOKEN=
# SFUD_GITHUB_REPOSITORY=https://github.com/owner/repository.git
# SFUD_GITLAB_TOKEN=
# SFUD_GITLAB_REPOSITORY=https://gitlab.com/group/project.git
# SFUD_BITBUCKET_TOKEN=
# SFUD_BITBUCKET_REPOSITORY=https://bitbucket.org/workspace/repository.git
# REPOSITORY를 지정하면 Git으로 해당 저장소만 검증하며 계정 API 권한/이메일 불필요.
# REPOSITORY가 없으면 기존 계정 API 연결을 사용 (Bitbucket 이메일 필요).
# SFUD_BITBUCKET_EMAIL=atlassian-account@example.com

# Git 신규 등록/조회/가져오기 차단. 기존 이력과 준비된 배포 자료는 보존.
# SFUD_GIT_ENABLED=false

# Quick Deploy 신규 제출만 차단. 이미 Salesforce에 제출한 attempt의 조회·재확인은 계속 허용.
# SFUD_QUICK_DEPLOY_ENABLED=false

# 여러 웹 프로세스가 공유하는 SQLite 배포 준비 lease. 30~3600초, 기본 300초.
# SFUD_DEPLOYMENT_ADMISSION_LEASE_SECONDS=300

# 여러 웹 프로세스의 Salesforce 실행을 하나로 직렬화하는 SQLite lease. 30~3600초, 기본 300초.
# SFUD_DEPLOYMENT_EXECUTION_LEASE_SECONDS=300

# 실행 artifact 보존·용량·신규 snapshot 최소 여유 공간. 보호된 기록만으로 max를 넘으면
# 새 Dry-run/직접 배포는 503으로 차단하고 기존 기록은 삭제하지 않음.
# SFUD_RUN_RETENTION_HOURS=168
# SFUD_RUN_MAX_BYTES=5368709120
# SFUD_RUN_MIN_FREE_BYTES=536870912

# Git 임시 저장소 용량: 명시적 서버 옵션 > 새 환경변수 > 이전 UPLOAD 별칭 > 기본값
SFUD_USER_IMPORT_QUOTA_BYTES=524288000
SFUD_SERVER_IMPORT_QUOTA_BYTES=2147483648
# SFUD_USER_UPLOAD_QUOTA_BYTES / SFUD_SERVER_UPLOAD_QUOTA_BYTES는 한 릴리스 동안만 대체값으로 지원
