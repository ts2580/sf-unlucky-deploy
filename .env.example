# .env로 복사하면 start-local.sh / sfud.ps1에서 읽습니다.
# 내 PC에서 개발: LOCAL=true, SFUD_UI_HOST=127.0.0.1. 원격 접속 항목은 주석으로 둡니다.
# 선택 항목은 사용할 때만 주석을 풀고 값을 넣으세요. 홈 설정·OS 환경변수도 확인하세요.

# 개인용 여부. true: 실행 OS 계정의 sf CLI 인증 사용 / false: 사용자별 로그인·연결 관리.
# true + 루프백 + 접속 비밀번호 미설정이면 앱 로그인 없이 사용합니다.
LOCAL=false

# 앱 수신 주소. 두 모드 공통. 내 PC는 127.0.0.1, 원격은 서버 IP 또는 0.0.0.0.
# 원격 주소는 CLI의 --allow-remote 필요(start-local.sh는 자동 추가).
# SFUD_UI_HOST=127.0.0.1

# 앱 수신 포트. 기본 27546, 다른 앱과 포트가 겹칠 때 변경합니다.
# SFUD_UI_PORT=27546

# 브라우저 공개 주소. 도메인·HTTPS 프록시로 접속할 때 설정합니다(경로 없이).
# SFUD_PUBLIC_ORIGIN=https://deploy.example.com

# 신뢰할 프록시 IP/CIDR. 프록시를 사용할 때만 설정하며 여러 개는 쉼표로 구분합니다.
# SFUD_TRUSTED_PROXIES=192.168.0.56

# 개인용 앱 접속 비밀번호(12~128자). LOCAL=true에서 원격 주소·공개 주소·프록시 사용 시 필수.
# 설정하면 루프백에서도 비밀번호를 요구합니다. LOCAL=false에서는 사용하지 않습니다.
# SFUD_ACCESS_PASSWORD=

# Git·Salesforce 인증 저장용 공통 암호화 키. 앱 접속 비밀번호와는 별개입니다.
# 두 모드의 Git 토큰 저장 및 LOCAL=false의 Salesforce 연결 저장에 필요합니다.
# `openssl rand -hex 32`로 생성하고 기존 DB를 쓰는 동안 같은 값을 유지하세요.
# SFUD_TOKEN_SECRET=

# DB·실행 기록 저장 경로. 저장 위치를 고정하거나 개인용/팀용 데이터를 분리할 때 설정합니다.
# SFUD_DATA_DIR=/path/to/sfud-data

# 아래 OAuth 항목은 LOCAL=false에서 Salesforce 브라우저 연결을 제공할 때만 사용합니다.
# Salesforce 앱에 Web Server Flow, refresh_token/API scope와 아래 HTTPS callback을 등록하세요.
# callback: SFUD_PUBLIC_ORIGIN + /api/v1/salesforce/oauth/callback
# OAuth 앱의 Client ID(Consumer Key).
# SFUD_SF_OAUTH_CLIENT_ID=
# 같은 OAuth 앱의 Client Secret(Consumer Secret).
# SFUD_SF_OAUTH_CLIENT_SECRET=
