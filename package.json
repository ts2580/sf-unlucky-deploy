{
  "name": "sf-unlucky-deploy",
  "version": "0.1.0",
  "description": "Salesforce 메타데이터를 비교하고 안전하게 검증·배포하는 CLI",
  "private": true,
  "type": "module",
  "bin": {
    "sfud": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:cli && npm run build:ui",
    "build:cli": "tsc --project tsconfig.build.json && node scripts/make-cli-executable.mjs",
    "build:ui": "vite build --config ui/vite.config.ts",
    "check": "npm run typecheck && vitest run && npm run build",
    "dev": "tsx src/cli.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "prepack": "npm run build",
    "release:check": "node scripts/check-release-version.mjs",
    "test": "vitest run",
    "test:e2e": "node scripts/run-playwright.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --project tsconfig.json && tsc --project tsconfig.ui.json && tsc --project tsconfig.e2e.json",
    "verify": "npm run check && npm run test:e2e"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "fast-xml-parser": "^5.11.0",
    "fastify": "^5.12.1",
    "picocolors": "^1.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true
  }
}
